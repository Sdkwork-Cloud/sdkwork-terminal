  "components": {},
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "runtime-node",
            "package": "@sdkwork/terminal-workspace",
            "script": "_sdkwork:runtime:node",
            "required": false,
            "role": "worker"
          },
          {
            "id": "desktop-renderer",
            "package": "@sdkwork/terminal-workspace",
            "script": "dev:desktop",
            "required": true,
            "role": "api-standalone-gateway"
          },
          {
            "id": "terminal-browser",
            "role": "client",
            "applicationRoot": "apps/sdkwork-terminal-pc",
            "bindEnv": "SDKWORK_TERMINAL_WEB_DEV_INGRESS_BIND",
            "runtimeTargets": [
              "browser"
            ],
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "required": true
          }
        ],
        "healthSurfaces": [],
        "browserDeliveries": [
          {
            "id": "terminal-adaptive-web",
            "applicationRoot": "apps/sdkwork-terminal-pc",
            "clientArchitectures": [
              "pc-web",
              "h5"
            ],
            "originMode": "same-origin",
            "deliveryMode": "dev-server-proxy",
            "clientProcessId": "terminal-browser",
            "apiSurfaceId": "application.public-ingress",
            "preserveCanonicalPaths": true,
            "tabletArchitecture": "pc-web",
            "renderers": {
              "pc-web": {
                "applicationRoot": "apps/sdkwork-terminal-pc",
                "script": "dev",
                "defaultPort": 4598,
                "portEnv": "SDKWORK_TERMINAL_PC_INTERNAL_DEV_PORT",
                "env": {}
              },
              "h5": {
                "applicationRoot": "apps/sdkwork-terminal-h5",
                "script": "dev",
                "defaultPort": 4599,
                "portEnv": "SDKWORK_TERMINAL_H5_INTERNAL_DEV_PORT",
                "env": {}
              }
            }
          }
        ]
      },
