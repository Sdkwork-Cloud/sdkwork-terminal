# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# This demo environment MUST use a dedicated PostgreSQL schema/user `sdkwork_terminal_demo` and a
# dedicated Redis prefix `terminal-demo` on a distinct logical DB index so no cache key collides with
# another env sharing the deployment Redis.
SDKWORK_TERMINAL_DEPLOYMENT_PROFILE=cloud
SDKWORK_TERMINAL_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_TERMINAL_PROFILE_ID=cloud.demo


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_TERMINAL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_TERMINAL_APPLICATION_PUBLIC_HTTP_URL=https://api-demo.sdkwork.com/apps/sdkwork-terminal
SDKWORK_TERMINAL_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

VITE_SDKWORK_TERMINAL_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_TERMINAL_APPLICATION_PUBLIC_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_TERMINAL_WEB_DEV_INGRESS_BIND=127.0.0.1:4596
SDKWORK_TERMINAL_PC_INTERNAL_DEV_PORT=4598
SDKWORK_TERMINAL_H5_INTERNAL_DEV_PORT=4599