# cloud.development
SDKWORK_TERMINAL_DEPLOYMENT_PROFILE=cloud
SDKWORK_TERMINAL_ENVIRONMENT=development
SDKWORK_TERMINAL_PROFILE_ID=cloud.development


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_TERMINAL_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

SDKWORK_TERMINAL_APPLICATION_PUBLIC_HTTP_URL=https://api-dev.sdkwork.com/apps/sdkwork-terminal
SDKWORK_TERMINAL_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com

VITE_SDKWORK_TERMINAL_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
VITE_SDKWORK_TERMINAL_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_TERMINAL_WEB_DEV_INGRESS_BIND=127.0.0.1:4596
SDKWORK_TERMINAL_PC_INTERNAL_DEV_PORT=4598
SDKWORK_TERMINAL_H5_INTERNAL_DEV_PORT=4599

# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
