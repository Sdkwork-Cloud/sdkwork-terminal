{
  "name": "@sdkwork/terminal-workspace",
  "private": true,
  "version": "0.2.59",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "sdk:generate:local-runtime": "pnpm --filter @sdkwork/terminal-app-sdk run generate",
    "dev": "node ../../scripts/terminal-dev.mjs --target desktop",
    "dev:browser": "node ../../scripts/terminal-dev.mjs --target web",
    "lint": "node tools/scripts/run-quality-check.mjs",
    "pretest": "pnpm run sdk:generate:local-runtime",
    "test": "node tools/scripts/run-workspace-tests.mjs",
    "test:runtime-event-name-contract": "node --experimental-strip-types tests/runtime-event-name-contract.test.ts",
    "build": "node tools/scripts/run-web-vite.mjs build && node tools/scripts/run-vite-host.mjs build",
    "build:web": "node tools/scripts/run-web-vite.mjs build",
    "build:desktop": "node tools/scripts/run-tauri-cli.mjs build --config packages/sdkwork-terminal-pc-desktop/src-tauri/tauri.release.conf.json",
    "pretypecheck": "pnpm run sdk:generate:local-runtime",
    "typecheck": "node tools/scripts/run-typescript-cli.mjs --project tsconfig.web.json --noEmit && node tools/scripts/run-typescript-cli.mjs --project tsconfig.desktop.json --noEmit",
    "check:desktop": "cargo check --manifest-path packages/sdkwork-terminal-pc-desktop/src-tauri/Cargo.toml",
    "_sdkwork:runtime:node": "cargo run --manifest-path crates/sdkwork-terminal-runtime-node/Cargo.toml --bin sdkwork-terminal-runtime-node",
    "dev:desktop": "node ../../scripts/terminal-dev.mjs --target desktop",
    "smoke:windows-release-launch": "node tools/smoke/windows-release-launch-probe.mjs --inspect-launch --assert-passed --startup-delay-ms 6000",
    "verify": "node tools/scripts/run-full-verification.mjs",
    "verify:terminal-runtime": "node tools/scripts/verify-terminal-runtime.mjs",
    "verify:shell-package": "node --experimental-test-isolation=none --test tests/shell-third-party-consumer-smoke.test.mjs",
    "verify:typescript-probes": "node tools/scripts/run-typescript-probe-tests.mjs",
    "verify:windows-release": "node tools/scripts/verify-windows-release.mjs",
    "build:dev": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment dev",
    "build:test": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment test",
    "build:staging": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment staging",
    "build:prod": "node ../../../sdkwork-specs/tools/build-browser-client.mjs --app-root . --environment prod"
  },
  "dependencies": {
    "@sdkwork/auth-runtime-pc-react": "workspace:*",
    "@sdkwork/iam-app-sdk": "workspace:*",
    "@sdkwork/iam-contracts": "workspace:*",
    "@sdkwork/sdk-common": "^1.0.2",
    "@sdkwork/terminal-pc-core": "workspace:*",
    "@sdkwork/terminal-pc-desktop": "workspace:*",
    "@sdkwork/terminal-pc-infrastructure": "workspace:*",
    "@sdkwork/terminal-pc-shell": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@sdkwork/terminal-pc-contracts": "workspace:*",
    "@sdkwork/terminal-pc-types": "workspace:*",
    "@sdkwork/utils": "workspace:*",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.2",
    "vite": "^5.4.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
