{
  "name": "@sdkwork/terminal-pc-shell",
  "version": "0.2.59",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "sideEffects": [
    "./src/styles.css",
    "./src/shell-app.css",
    "./dist/styles.css",
    "./dist/shell-app.css",
    "./dist/xterm.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./integration": {
      "types": "./src/integration.tsx",
      "import": "./src/integration.tsx",
      "default": "./src/integration.tsx"
    },
    "./web-integration": {
      "types": "./src/web-integration.tsx",
      "import": "./src/web-integration.tsx",
      "default": "./src/web-integration.tsx"
    },
    "./styles.css": {
      "types": "./src/styles.css",
      "import": "./src/styles.css",
      "default": "./src/styles.css"
    }
  },
  "scripts": {
    "build": "node ./build.mjs",
    "clean": "node ./build.mjs --clean-only",
    "prepack": "node ./scripts/rewrite-publish-exports.mjs",
    "postpack": "node ./scripts/rewrite-publish-exports.mjs --restore"
  },
  "dependencies": {
    "@sdkwork/terminal-pc-commons": "workspace:*",
    "@sdkwork/terminal-pc-core": "workspace:*",
    "@sdkwork/terminal-pc-infrastructure": "workspace:*",
    "@sdkwork/terminal-pc-types": "workspace:*",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "vite": "^5.4.0"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "private": true
}
